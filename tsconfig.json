{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "sat-loom-web-app v5 latest 1",
    "beatdrop---south-indian-party",
    "functions",
    "utils/core/analytics.ts",
    "utils/core/enhanced-error-handler.ts",
    "utils/core/worker-manager.ts",
    "utils/infra/firebase-query-optimizer.ts",
    "utils/infra/connection-pool.ts",
    "utils/infra/knock-knock.ts",
    "utils/infra/twitch-player.ts",
    "utils/infra/prefetcher.ts",
    "utils/infra/cdn-manager.ts",
    "utils/infra/message-replies.ts",
    "utils/infra/message-pins.ts",
    "utils/infra/message-scheduler.ts",
    "utils/infra/reaction-manager.ts",
    "utils/hardware/noise-suppression.ts",
    "utils/hardware/video-call-scaler.ts",
    "utils/hardware/video-quality-scaler.ts",
    "utils/hardware/local-recording.ts",
    "utils/games/pictionary-game.ts",
    "utils/games/turn-manager.ts"
  ]
}
