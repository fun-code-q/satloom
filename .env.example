# Firebase Configuration Template
# IMPORTANT: Copy this file to .env.local and fill in your actual Firebase credentials
# Get these values from Firebase Console > Project Settings > General

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# WebRTC STUN Servers (Public/Reliable)
NEXT_PUBLIC_STUN_SERVER_1=stun:stun.l.google.com:19302
NEXT_PUBLIC_STUN_SERVER_2=stun:stun1.l.google.com:19302
NEXT_PUBLIC_STUN_SERVER_3=stun:stun2.l.google.com:19302
NEXT_PUBLIC_STUN_SERVER_4=stun:stun3.l.google.com:19302
NEXT_PUBLIC_STUN_SERVER_5=stun:stun4.l.google.com:19302

# TURN Servers (Optional but Recommended for Production)
#
# SatLoom reads NEXT_PUBLIC_TURN_SERVER_1..N with matching _USERNAME_N and
# _CREDENTIAL_N (see lib/webrtc.ts buildIceServers). A TURN entry is only
# used when all three are present; otherwise the app falls back to STUN-only
# and users behind symmetric NAT (~15-20%) cannot connect.
#
# !! Do NOT use the public Open Relay Project (`openrelayproject` credentials). !!
# Those credentials are publicly known, have no SLA, and are commonly abused.
# Supply your own TURN service. Recommended providers:
#   - Cloudflare Calls (TURN as a service)
#   - Twilio NAT Traversal Service
#   - Self-hosted coturn with per-user time-limited credentials (best for privacy)
#
# Replace the placeholders below with your own TURN endpoint + credentials.
# Up to 6 servers are supported (NEXT_PUBLIC_TURN_SERVER_1 .. _6).
NEXT_PUBLIC_TURN_SERVER_1=turn:your-turn-server.example.com:3478
NEXT_PUBLIC_TURN_USERNAME_1=your-turn-username
NEXT_PUBLIC_TURN_CREDENTIAL_1=your-turn-credential
# Optional second server (TCP/TLS):
# NEXT_PUBLIC_TURN_SERVER_2=turn:your-turn-server.example.com:3478?transport=tcp
# NEXT_PUBLIC_TURN_USERNAME_2=your-turn-username
# NEXT_PUBLIC_TURN_CREDENTIAL_2=your-turn-credential
